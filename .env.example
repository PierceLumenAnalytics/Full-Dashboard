# GEMINI_API_KEY: Server-side API key for Google Gemini AI insights generation.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
APP_BASE_URL="http://localhost:3000"

# PORTAL_TOKEN_ENCRYPTION_KEY: 32-byte AES-256 key (64 hex characters) for encrypting client portal tokens at rest.
# Must be set in production environment variables (e.g. Vercel / Cloud Run).
PORTAL_TOKEN_ENCRYPTION_KEY=

